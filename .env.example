# ForgeAI
FORGEAI_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional GitHub token for higher API limits and private repositories.
GITHUB_TOKEN=

# Optional semantic retrieval
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
PATCH_MODEL=gpt-6-luna

# Future persistence / model integrations
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
DATABASE_URL=
LLM_PROVIDER=
LLM_API_KEY=

# Sandboxed validation
VALIDATION_COMMAND_TIMEOUT_SECONDS=120
VALIDATION_DOCKER_MEMORY=768m
VALIDATION_DOCKER_CPUS=1.0
VALIDATION_PYTHON_IMAGE=python:3.12-slim
VALIDATION_NODE_IMAGE=node:22-slim
